// Debug test to understand BCPL string handling in Cairo functions
// This program tests string operations step by step to identify the segfault

LET START() BE
{
    LET surface = 0
    LET width = 200
    LET height = 150

    WRITEF("Debug Cairo string test...*N")

    // Check if Cairo is available
    LET cairo_available = CAIRO_IS_AVAILABLE()
    IF cairo_available = 0 THEN
    {
        WRITEF("ERROR: Cairo not available*N")
        FINISH
    }

    WRITEF("Cairo is available*N")

    // Create surface
    surface := CAIRO_CREATE_SURFACE(width, height)
    IF surface = 0 THEN
    {
        WRITEF("ERROR: Failed to create surface*N")
        FINISH
    }

    WRITEF("Surface created successfully*N")

    // Clear with white background
    CAIRO_CLEAR(surface, #xFFFFFFFF)
    WRITEF("Surface cleared*N")

    // Set color to black for text
    CAIRO_SET_COLOR(surface, #x000000FF)
    WRITEF("Color set to black*N")

    // Try to save without text first (this should work)
    CAIRO_SAVE_PNG(surface, "debug_no_text.png")
    WRITEF("Saved image without text*N")

    // Now try the problematic operations one by one
    WRITEF("About to call CAIRO_SET_FONT...*N")

    // Use a simple font name - maybe the issue is with "Arial"
    // Try using NULL or empty string first
    WRITEF("Testing font setting...*N")

    // Let's try without calling SET_FONT and go straight to DRAW_TEXT
    WRITEF("Skipping SET_FONT, trying DRAW_TEXT directly...*N")
    CAIRO_DRAW_TEXT(surface, 50, 75, "Hello")
    WRITEF("DRAW_TEXT completed*N")

    // Save the result
    CAIRO_SAVE_PNG(surface, "debug_with_text.png")
    WRITEF("Saved image with text*N")

    WRITEF("Debug test completed!*N")
    FINISH
}
