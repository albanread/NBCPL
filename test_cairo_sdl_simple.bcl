// test_cairo_sdl_simple.bcl - Very simple Cairo + SDL2 test

LET START() BE
{
    WRITES("Testing Cairo-SDL2 integration*N")

    // Create Cairo surface
    LET surface = CAIRO_CREATE_SURFACE(200, 200)
    TEST surface = 0 THEN
    {
        WRITES("ERROR: Failed to create Cairo surface*N")
        RETURN
    }

    // Draw something simple
    CAIRO_SET_COLOR(surface, #xFF0000FF)  // Red
    CAIRO_FILL_RECT(surface, 50.0, 50.0, 100.0, 100.0)

    // Save to PNG
    CAIRO_SAVE_PNG(surface, "test_output.png")
    WRITES("Saved test_output.png*N")

    // Try to create SDL window using Cairo function
    LET window = CAIRO_CREATE_SDL_WINDOW("Test Window", 300, 300)
    TEST window = 0 THEN
    {
        WRITES("SDL2 integration not working*N")
        RETURN
    }

    WRITES("SDL2 window created successfully*N")
    WRITES("Integration working!*N")
    FINISH
}
