// Test Cairo with explicit float literals to check parameter passing
// This program tests if the issue is with integer vs float parameter conversion

LET START() BE
{
    LET surface = 0
    LET width = 200
    LET height = 150

    WRITEF("Cairo float test...*N")

    // Check if Cairo is available
    LET cairo_available = CAIRO_IS_AVAILABLE()
    IF cairo_available = 0 THEN
    {
        WRITEF("ERROR: Cairo not available*N")
        FINISH
    }

    WRITEF("Cairo is available*N")

    // Create surface
    WRITEF("Creating surface...*N")
    surface := CAIRO_CREATE_SURFACE(width, height)

    IF surface = 0 THEN
    {
        WRITEF("ERROR: Failed to create surface*N")
        FINISH
    }

    WRITEF("Surface created with handle: %N*N", surface)

    // Clear with white
    WRITEF("Clearing surface...*N")
    CAIRO_CLEAR(surface, #xFFFFFFFF)

    // Set red color
    WRITEF("Setting color...*N")
    CAIRO_SET_COLOR(surface, #xFF0000FF)

    // Draw rectangle using explicit float literals
    WRITEF("Drawing rectangle with float literals...*N")
    CAIRO_FILL_RECT(surface, 10.0, 10.0, 50.0, 30.0)

    // Save image
    WRITEF("Saving image...*N")
    CAIRO_SAVE_PNG(surface, "float_fix_test.png")

    WRITEF("Test completed successfully!*N")
    FINISH
}
