// Definitive test to trigger scratch register exhaustion
// This test uses complex expressions that will definitely consume scratch registers

LET START() BE {
    WRITEF("Testing definitive scratch register exhaustion*N")

    // This call should exhaust scratch registers because each argument
    // is a complex expression that requires multiple scratch registers
    LET result = exhaustion_test(
        func1() + func2(),              // Complex expr 1: function calls + addition
        func3() * func4(),              // Complex expr 2: function calls + multiplication
        (func5() - func6()) / 2,        // Complex expr 3: nested operations
        func7() + (func8() * 3),        // Complex expr 4: mixed operations
        func9() - func10(),             // Complex expr 5: more function calls
        (func11() + func12()) * 2,      // Complex expr 6: nested with multiplication
        func13() / (func14() + 1),      // Complex expr 7: division with nested addition
        func15() + func16() + func17()  // Complex expr 8: triple addition - should crash
    )

    WRITEF("Miracle: didn't crash! Result: %d*N", result)
}

LET exhaustion_test(a, b, c, d, e, f, g, h) BE {
    RESULTIS a + b + c + d + e + f + g + h
}

// Each function call forces the compiler to use scratch registers
LET func1() BE RESULTIS 10
LET func2() BE RESULTIS 20
LET func3() BE RESULTIS 30
LET func4() BE RESULTIS 40
LET func5() BE RESULTIS 50
LET func6() BE RESULTIS 60
LET func7() BE RESULTIS 70
LET func8() BE RESULTIS 80
LET func9() BE RESULTIS 90
LET func10() BE RESULTIS 100
LET func11() BE RESULTIS 110
LET func12() BE RESULTIS 120
LET func13() BE RESULTIS 130
LET func14() BE RESULTIS 140
LET func15() BE RESULTIS 150
LET func16() BE RESULTIS 160
LET func17() BE RESULTIS 170

// Alternative test with deeply nested expressions
LET test_deeply_nested() BE {
    WRITEF("Testing deeply nested expressions*N")

    LET result = nested_test(
        deep_calc(1, 2, 3),
        deep_calc(4, 5, 6),
        deep_calc(7, 8, 9),
        deep_calc(10, 11, 12),
        deep_calc(13, 14, 15),
        deep_calc(16, 17, 18),
        deep_calc(19, 20, 21)  // 7 args - should work
    )

    WRITEF("Nested test result: %d*N", result)
}

LET nested_test(a, b, c, d, e, f, g) BE {
    RESULTIS a + b + c + d + e + f + g
}

LET deep_calc(x, y, z) BE {
    LET temp1 = x * y
    LET temp2 = temp1 + z
    LET temp3 = temp2 * 2
    RESULTIS temp3 + helper_func(x)
}

LET helper_func(n) BE {
    LET result = n * n
    RESULTIS result + another_helper(n)
}

LET another_helper(m) BE {
    RESULTIS m + 42
}
