#include "ArgumentEvaluator.h"
#include "../../NewCodeGenerator.h"
#include "../../AST.h"
#include "../../Encoder.h"
#include <stdexcept>

ArgumentEvaluator::ArgumentEvaluator(NewCodeGenerator& codegen) 
    : codegen_(codegen), total_stack_bytes_(0), stack_allocated_(false) {
}

size_t ArgumentEvaluator::evaluate_arguments(
    const std::vector<std::unique_ptr<Expression>>& arguments,
    const std::vector<VarType>& arg_types,
    const std::vector<VarType>& expected_types
) {
    if (arguments.size() != arg_types.size()) {
        throw std::runtime_error("Argument count mismatch: expressions=" + 
                                 std::to_string(arguments.size()) + 
                                 ", types=" + std::to_string(arg_types.size()));
    }
    
    if (!expected_types.empty() && arguments.size() != expected_types.size()) {
        throw std::runtime_error("Expected types count mismatch");
    }

    // Reset state
    reset();
    
    // Build argument info
    for (size_t i = 0; i < arguments.size(); ++i) {
        VarType expected = expected_types.empty() ? VarType::UNKNOWN : expected_types[i];
        argument_info_.emplace_back(arg_types[i], expected);
    }

    if (arguments.empty()) {
        return 0;  // No arguments to evaluate
    }

    codegen_.debug_print("=== ArgumentEvaluator: Right-to-Left Stack Evaluation ===");
    codegen_.debug_print("Total arguments: " + std::to_string(arguments.size()));

    // Step 1: Calculate stack layout and pre-allocate space
    calculate_stack_layout();
    allocate_stack_space();

    // Step 2: Evaluate arguments in REVERSE order (right-to-left)
    for (int i = static_cast<int>(arguments.size()) - 1; i >= 0; --i) {
        codegen_.debug_print("Evaluating argument " + std::to_string(i) + " (reverse order)");
        
        // Generate code for this argument expression
        codegen_.generate_expression_code(*arguments[i]);
        std::string result_reg = codegen_.expression_result_reg_;
        
        // Perform type coercion if needed
        VarType src_type = arg_types[i];
        VarType dest_type = argument_info_[i].expected_type;
        if (dest_type != VarType::UNKNOWN) {
            result_reg = coerce_type_if_needed(result_reg, src_type, dest_type);
        }
        
        // Immediately store to stack (this frees all scratch registers)
        bool is_float = (dest_type == VarType::FLOAT) || 
                       (dest_type == VarType::UNKNOWN && src_type == VarType::FLOAT);
        store_to_stack(result_reg, argument_info_[i].stack_offset, is_float);
        
        // Release the result register (it's now safely on stack)
        codegen_.register_manager_.release_register(result_reg);
        
        codegen_.debug_print("Argument " + std::to_string(i) + " stored at SP+" + 
                           std::to_string(argument_info_[i].stack_offset));
    }

    codegen_.debug_print("All arguments evaluated and stored on stack");
    return total_stack_bytes_;
}

void ArgumentEvaluator::load_to_abi_registers(int start_x_reg, int start_d_reg) {
    if (!stack_allocated_) {
        throw std::runtime_error("Cannot load to ABI registers: arguments not evaluated");
    }

    codegen_.debug_print("Loading arguments from stack to ABI registers");
    codegen_.debug_print("Starting registers: X" + std::to_string(start_x_reg) + 
                        ", D" + std::to_string(start_d_reg));

    int ngrn = start_x_reg;  // Next General-purpose Register Number
    int nsrn = start_d_reg;  // Next SIMD/Float Register Number

    // Load arguments in FORWARD order (left-to-right) into ABI registers
    for (size_t i = 0; i < argument_info_.size(); ++i) {
        const ArgumentInfo& arg_info = argument_info_[i];
        
        // Determine target type
        VarType target_type = (arg_info.expected_type != VarType::UNKNOWN) ? 
                              arg_info.expected_type : arg_info.type;

        if (target_type == VarType::FLOAT) {
            // Float argument goes to D register
            if (nsrn >= 8) {
                throw std::runtime_error("Too many float arguments for ARM64 ABI (max 8 D registers)");
            }
            
            std::string dest_reg = "D" + std::to_string(nsrn);
            load_from_stack(arg_info.stack_offset, dest_reg, true);
            
            codegen_.debug_print("Loaded argument " + std::to_string(i) + " to " + dest_reg);
            nsrn++;
        } else {
            // Integer/pointer argument goes to X register
            if (ngrn >= 8) {
                throw std::runtime_error("Too many integer arguments for ARM64 ABI (max 8 X registers)");
            }
            
            std::string dest_reg = "X" + std::to_string(ngrn);
            load_from_stack(arg_info.stack_offset, dest_reg, false);
            
            codegen_.debug_print("Loaded argument " + std::to_string(i) + " to " + dest_reg);
            ngrn++;
        }
    }

    codegen_.debug_print("ABI register loading complete: used " + std::to_string(ngrn - start_x_reg) + 
                        " X regs, " + std::to_string(nsrn - start_d_reg) + " D regs");
}

void ArgumentEvaluator::cleanup_stack() {
    if (!stack_allocated_ || total_stack_bytes_ == 0) {
        return;  // Nothing to clean up
    }

    // Restore stack pointer: ADD SP, SP, #total_bytes
    codegen_.emit(Encoder::create_add_imm("SP", "SP", total_stack_bytes_));
    codegen_.debug_print("Cleaned up " + std::to_string(total_stack_bytes_) + " bytes from stack");
    
    stack_allocated_ = false;
}

void ArgumentEvaluator::reset() {
    argument_info_.clear();
    total_stack_bytes_ = 0;
    stack_allocated_ = false;
}

void ArgumentEvaluator::calculate_stack_layout() {
    if (argument_info_.empty()) {
        total_stack_bytes_ = 0;
        return;
    }

    // Each argument gets 8 bytes on the stack (standard ARM64 alignment)
    // Arguments are laid out in forward order: arg0 at SP+0, arg1 at SP+8, etc.
    for (size_t i = 0; i < argument_info_.size(); ++i) {
        argument_info_[i].stack_offset = i * 8;
    }
    
    total_stack_bytes_ = argument_info_.size() * 8;
    
    // Ensure 16-byte stack alignment as required by ARM64 ABI
    if (total_stack_bytes_ % 16 != 0) {
        total_stack_bytes_ = ((total_stack_bytes_ + 15) / 16) * 16;
    }

    codegen_.debug_print("Stack layout calculated: " + std::to_string(total_stack_bytes_) + " bytes total");
}

void ArgumentEvaluator::allocate_stack_space() {
    if (total_stack_bytes_ == 0) {
        stack_allocated_ = true;  // Trivially allocated
        return;
    }

    // Pre-adjust stack pointer: SUB SP, SP, #total_bytes
    codegen_.emit(Encoder::create_sub_imm("SP", "SP", total_stack_bytes_));
    codegen_.debug_print("Pre-allocated " + std::to_string(total_stack_bytes_) + " bytes on stack");
    
    stack_allocated_ = true;
}

void ArgumentEvaluator::store_to_stack(const std::string& reg, size_t stack_offset, bool is_float) {
    if (!stack_allocated_) {
        throw std::runtime_error("Cannot store to stack: space not allocated");
    }

    if (is_float) {
        // Store D register to stack: STR Dn, [SP, #offset]
        codegen_.emit(Encoder::create_str_fp_imm(reg, "SP", stack_offset));
        codegen_.debug_print("Stored float " + reg + " to [SP+" + std::to_string(stack_offset) + "]");
    } else {
        // Store X register to stack: STR Xn, [SP, #offset]  
        codegen_.emit(Encoder::create_str_imm(reg, "SP", stack_offset));
        codegen_.debug_print("Stored integer " + reg + " to [SP+" + std::to_string(stack_offset) + "]");
    }
}

void ArgumentEvaluator::load_from_stack(size_t stack_offset, const std::string& dest_reg, bool is_float) {
    if (!stack_allocated_) {
        throw std::runtime_error("Cannot load from stack: space not allocated");
    }

    if (is_float) {
        // Load from stack to D register: LDR Dn, [SP, #offset]
        codegen_.emit(Encoder::create_ldr_fp_imm(dest_reg, "SP", stack_offset));
        codegen_.debug_print("Loaded float from [SP+" + std::to_string(stack_offset) + "] to " + dest_reg);
    } else {
        // Load from stack to X register: LDR Xn, [SP, #offset]
        codegen_.emit(Encoder::create_ldr_imm(dest_reg, "SP", stack_offset));
        codegen_.debug_print("Loaded integer from [SP+" + std::to_string(stack_offset) + "] to " + dest_reg);
    }
}

std::string ArgumentEvaluator::coerce_type_if_needed(const std::string& src_reg, VarType src_type, VarType dest_type) {
    if (dest_type == VarType::UNKNOWN || src_type == dest_type) {
        return src_reg;  // No coercion needed
    }

    codegen_.debug_print("Type coercion needed: " + vartype_to_string(src_type) + " -> " + vartype_to_string(dest_type));

    if (src_type == VarType::INTEGER && dest_type == VarType::FLOAT) {
        // Integer to float: acquire temp float register and convert
        std::string float_reg = codegen_.register_manager_.acquire_fp_scratch_reg();
        codegen_.emit(Encoder::create_scvtf_reg(float_reg, src_reg));
        codegen_.register_manager_.release_register(src_reg);
        codegen_.debug_print("Converted integer " + src_reg + " to float " + float_reg);
        return float_reg;
    } 
    else if (src_type == VarType::FLOAT && dest_type == VarType::INTEGER) {
        // Float to integer: acquire temp integer register and convert
        std::string int_reg = codegen_.register_manager_.acquire_scratch_reg(codegen_);
        codegen_.generate_float_to_int_truncation(int_reg, src_reg);
        codegen_.register_manager_.release_register(src_reg);
        codegen_.debug_print("Converted float " + src_reg + " to integer " + int_reg);
        return int_reg;
    }
    else {
        // For other type coercions, assume no conversion needed but log warning
        codegen_.debug_print("Warning: Unsupported type coercion " + vartype_to_string(src_type) + 
                           " -> " + vartype_to_string(dest_type) + ", using source as-is");
        return src_reg;
    }
}
