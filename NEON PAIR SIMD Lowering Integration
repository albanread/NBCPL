/**
 * @class ArgumentEvaluator
 * @brief Implements robust right-to-left stack-based argument evaluation for function calls
 * 
 * This class solves the critical scratch register exhaustion and clobbering problems
 * in function argument evaluation by using the industry-standard approach:
 * 
 * 1. Pre-allocate stack space for all arguments
 * 2. Evaluate arguments right-to-left (reverse order)
 * 3. Store each result immediately to stack (frees scratch registers)
 * 4. Load from stack to ABI registers when ready to call
 * 
 * This approach uses O(1) scratch register pressure regardless of argument count
 * and is completely clobber-proof.
 */
class ArgumentEvaluator {
public:
    struct ArgumentInfo {
        VarType type;
        VarType expected_type;  // For type coercion, UNKNOWN if no coercion needed
        size_t stack_offset;    // Offset from SP where this argument is stored
        
        ArgumentInfo(VarType t, VarType expected = VarType::UNKNOWN) 
            : type(t), expected_type(expected), stack_offset(0) {}
    };

    /**
     * Constructor
     * @param codegen Reference to the code generator for emitting instructions
     */
    explicit ArgumentEvaluator(NewCodeGenerator& codegen);

    /**
     * Evaluate arguments using robust right-to-left stack-based approach
     * 
     * @param arguments Vector of argument expressions to evaluate
     * @param arg_types Vector of actual argument types
     * @param expected_types Vector of expected types (empty if no coercion)
     * @return Total stack bytes allocated (for cleanup)
     */
    size_t evaluate_arguments(
        const std::vector<std::unique_ptr<Expression>>& arguments,
        const std::vector<VarType>& arg_types,
        const std::vector<VarType>& expected_types = {}
    );

    /**
     * Load evaluated arguments from stack into ABI registers
     * Must be called after evaluate_arguments() and before function call
     * 
     * @param start_x_reg Starting X register number (0 for X0, 1 for X1, etc.)
     * @param start_d_reg Starting D register number (0 for D0, etc.)
     */
    void load_to_abi_registers(int start_x_reg = 0, int start_d_reg = 0);

    /**
     * Clean up stack space allocated for arguments
     * Must be called after the function call
     */
    void cleanup_stack();

    /**
     * Get the number of arguments that were evaluated
     */
    size_t get_argument_count() const { return argument_info_.size(); }

    /**
     * Reset the evaluator state for reuse
     */
    void reset();

private:
    NewCodeGenerator& codegen_;
    std::vector<ArgumentInfo> argument_info_;
    size_t total_stack_bytes_;
    bool stack_allocated_;

    /**
     * Calculate stack layout for arguments
     * Each argument gets 8 bytes (for both X and D registers)
     */
    void calculate_stack_layout();

    /**
     * Pre-allocate stack space for all arguments
     */
    void allocate_stack_space();

    /**
     * Store a register value to the stack at given offset
     * @param reg Register to store
     * @param stack_offset Offset from SP
     * @param is_float True for D registers, false for X registers
     */
    void store_to_stack(const std::string& reg, size_t stack_offset, bool is_float);

    /**
     * Load a value from stack to ABI register
     * @param stack_offset Offset from SP
     * @param dest_reg Destination ABI register
     * @param is_float True for D registers, false for X registers
     */
    void load_from_stack(size_t stack_offset, const std::string& dest_reg, bool is_float);

    /**
