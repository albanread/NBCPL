        std::cout << "  ./NewBCPL --test-encode \"fminp_*\"       # Test FMINP family" << std::endl;
        std::cout << "  ./NewBCPL --test-encode \"*_4s\"         # Test all 4S layouts" << std::endl;
        std::cout << "  ./NewBCPL --test-encode \"scalar_*\"     # Test all scalar operations" << std::endl;
