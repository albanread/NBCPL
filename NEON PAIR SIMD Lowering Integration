        std::string func_ptr_reg = expression_result_reg_;
        
        emit(Encoder::create_branch_with_link_register(func_ptr_reg));
        debug_print("Emitted BLR " + func_ptr_reg);
        
        register_manager_.release_register(func_ptr_reg);
    }

    // Step 6: Handle return value
    // Function return value is in X0 (integer) or D0 (float)
    auto func_info = ASTAnalyzer::getInstance().get_function_info(
        dynamic_cast<VariableAccess*>(node.function_expr.get()) ? 
        dynamic_cast<VariableAccess*>(node.function_expr.get())->name : "");
    
    if (func_info.is_valid() && func_info.return_type == VarType::FLOAT) {
        expression_result_reg_ = "D0";
        debug_print("Function returns float in D0");
    } else {
        expression_result_reg_ = "X0"; 
        debug_print("Function returns integer/pointer in X0");
    }

    // Step 7: Clean up stack space
    evaluator.cleanup_stack();
    
    debug_print("=== Function Call Complete ===");
}

void NewCodeGenerator::handle_special_built_in_call_v2(
    FunctionCall& node, 
    const std::string& func_name,
    ArgumentEvaluator& evaluator
) {
    debug_print("Handling special built-in: " + func_name);

    if (func_name == "LEN") {
        // LEN function: X0 contains pointer to vector/array
        // Return length from the header (stored at offset -8 from data)
        std::string len_reg = register_manager_.acquire_scratch_reg(*this);
        emit(Encoder::create_ldr_imm(len_reg, "X0", -8, "Load length from vector header"));
        emit(Encoder::create_mov_reg("X0", len_reg));
        register_manager_.release_register(len_reg);
        expression_result_reg_ = "X0";
        debug_print("LEN: loaded length from vector header");
        
    } else if (func_name == "WRITEF") {
        // WRITEF: Handle format string and arguments
        handle_writef_call_v2(node, evaluator);
        
    } else if (func_name == "READCH" || func_name == "WRCH") {
        // Simple I/O functions - just call through
        emit(Encoder::create_branch_with_link(func_name));
        expression_result_reg_ = "X0";
        
    } else {
        // Unknown built-in - treat as regular function
        emit(Encoder::create_branch_with_link(func_name));
        expression_result_reg_ = "X0";
        debug_print("Unknown built-in treated as regular function");
    }
}

void NewCodeGenerator::handle_writef_call_v2(FunctionCall& node, ArgumentEvaluator& evaluator) {
    debug_print("Handling WRITEF with robust argument evaluation");
    
    if (node.arguments.empty()) {
        throw std::runtime_error("WRITEF requires at least a format string argument");
    }

    // Arguments are already evaluated and in ABI registers by ArgumentEvaluator
    // X0 = format string, X1,X2,... = arguments
    
    // Call the runtime WRITEF implementation
    emit(Encoder::create_branch_with_link("_bcpl_writef"));
    expression_result_reg_ = "X0";  // WRITEF typically returns void, but X0 is safe
    
    debug_print("WRITEF call completed");
}

bool NewCodeGenerator::is_special_built_in(const std::string& func_name) {
    return func_name == "LEN" || 
           func_name == "WRITEF" || 
           func_name == "READCH" || 
           func_name == "WRCH" ||
           func_name == "ABS" ||
           func_name == "SQRT";
}

// Utility function to migrate existing code gradually
void NewCodeGenerator::visit(FunctionCall& node) {
    // For now, detect problematic cases and route to v2
    if (node.arguments.size() > 4) {
        debug_print("Large argument count detected, using robust v2 implementation");
        visit_function_call_v2(node);
        return;
    }
    
    // Check for complex argument expressions that might cause clobbering
    bool has_complex_args = false;
    for (const auto& arg : node.arguments) {
        if (dynamic_cast<FunctionCall*>(arg.get()) || 
            dynamic_cast<BinaryOp*>(arg.get())) {
            has_complex_args = true;
            break;
        }
    }
    
    if (has_complex_args) {
        debug_print("Complex argument expressions detected, using robust v2 implementation");
        visit_function_call_v2(node);
        return;
    }
    
    // For simple cases, can still use original implementation for now
    debug_print("Using original function call implementation (simple case)");
    // Call original implementation here - this allows gradual migration
    visit_function_call_original(node);
}
