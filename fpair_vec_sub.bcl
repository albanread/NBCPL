LET START() BE $(

	LET V1 = FPAIRS(5)
	LET V2 = FPAIRS(5)

	FOR I=0 TO 4 DO $(
  	 V1!I := FPAIR(20.5,15.75)
         V2!I := FPAIR(5.25,3.5)
	$)

	LET V3 = V1-V2

	WRITEF("*NFPAIR vector subtraction completed!*N")
	WRITEF("Length of V3: %N*N", LEN(V3))

	WRITEF("*NVerifying results:*N")
	WRITEF("Expected: Each V3[i] = V1[i] - V2[i] = (20.5,15.75) - (5.25,3.5) = (15.25,12.25)*N")

	FOR I=0 TO 4 DO $(
		LET result_fpair = V3!I
		WRITEF("V3[%N] = %Q*N", I, result_fpair)
	$)

$)
