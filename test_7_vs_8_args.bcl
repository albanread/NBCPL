// Test to find the exact breaking point for scratch register exhaustion
// ARM64 has exactly 7 scratch registers: X9, X10, X11, X12, X13, X14, X15

LET START() BE {
    WRITEF("Testing scratch register limits*N")

    // Test 1: 7 arguments - should work (uses all 7 scratch registers)
    WRITEF("Testing 7 arguments...*N")
    LET result7 = test_7_args(1, 2, 3, 4, 5, 6, 7)
    WRITEF("Success with 7 args*N")

    // Test 2: 8 arguments - should crash (needs 8th scratch register)
    WRITEF("Testing 8 arguments...*N")
    LET result8 = test_8_args(1, 2, 3, 4, 5, 6, 7, 8)
    WRITEF("Success with 8 args*N")
}

LET test_7_args(a, b, c, d, e, f, g) BE {
    // Simple function with 7 args - avoid WRITEF with many args
    RESULTIS a + b + c + d + e + f + g
}

LET test_8_args(a, b, c, d, e, f, g, h) BE {
    // Simple function with 8 args - should crash during arg evaluation
    RESULTIS a + b + c + d + e + f + g + h
}

// Test with complex expressions to make clobbering more likely
LET test_complex_7_args() BE {
    WRITEF("Testing 7 complex arguments...*N")
    LET result = complex_7_args(
        10 + 20,        // Complex expr 1 - uses scratch regs
        30 * 40,        // Complex expr 2 - uses more scratch regs
        simple_func(),  // Function call - uses even more scratch regs
        50 - 60,        // Complex expr 4
        another_func(), // Another function call
        70 / 10,        // Division
        80 + 90         // Final complex expr - should exhaust all 7 scratch regs
    )
    WRITEF("Success*N")
}

LET complex_7_args(a, b, c, d, e, f, g) BE {
    RESULTIS a + b + c + d + e + f + g
}

LET simple_func() BE {
    // This function call will use scratch registers during evaluation
    LET temp = 42 * 2
    RESULTIS temp + 10
}

LET another_func() BE {
    // Another function that uses scratch registers
    LET x = 100
    LET y = 200
    LET z = x + y
    RESULTIS z / 2
}
