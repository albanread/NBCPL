// test_cairo_sdl_final.bcl - Final working Cairo + SDL2 integration test

LET START() BE
{
    WRITES("Final Cairo + SDL2 Integration Test*N")

    // Initialize SDL2 first (required for SAMM backend)
    LET sdl_result = SDL2_INIT()
    TEST sdl_result < 0 THEN
    {
        WRITES("ERROR: SDL2 initialization failed*N")
        FINISH
    }
    WRITES("SDL2 initialized successfully*N")

    // Create Cairo surface (400x300)
    LET surface = CAIRO_CREATE_SURFACE(400, 300)
    TEST surface = 0 THEN
    {
        WRITES("ERROR: Failed to create Cairo surface*N")
        SDL2_QUIT()
        FINISH
    }
    WRITES("Cairo surface created*N")

    // Clear surface with white background
    CAIRO_SET_COLOR(surface, #xFFFFFFFF)  // White
    CAIRO_CLEAR(surface)

    // Draw a red rectangle
    CAIRO_SET_COLOR(surface, #xFF0000FF)  // Red
    CAIRO_FILL_RECT(surface, 50, 50, 150, 100)

    // Draw a blue circle
    CAIRO_SET_COLOR(surface, #x0000FFFF)  // Blue
    CAIRO_FILL_CIRCLE(surface, 300, 75, 40)

    // Draw green text (if text rendering works)
    CAIRO_SET_COLOR(surface, #x00FF00FF)  // Green
    CAIRO_FILL_RECT(surface, 100, 200, 200, 30)

    WRITES("Cairo drawing completed*N")

    // Create regular SDL2 window first
    LET window = SDL2_CREATE_WINDOW("Cairo + SDL2 Demo")
    TEST window = 0 THEN
    {
        WRITES("ERROR: Failed to create SDL2 window*N")
        SDL2_QUIT()
        FINISH
    }

    // Create renderer
    LET renderer = SDL2_CREATE_RENDERER(window)
    TEST renderer = 0 THEN
    {
        WRITES("ERROR: Failed to create renderer*N")
        SDL2_DESTROY_WINDOW(window)
        SDL2_QUIT()
        FINISH
    }

    WRITES("SDL2 window and renderer created*N")

    // Try to convert Cairo surface to SDL texture
    LET texture = CAIRO_TO_SDL_TEXTURE(surface, renderer)
    TEST texture = 0 THEN
    {
        WRITES("WARNING: Cairo to SDL texture conversion failed*N")
        WRITES("Showing plain SDL2 graphics instead*N")

        // Fallback - draw with SDL2 directly
        LET running = TRUE
        LET frames = 0
        WHILE running AND frames < 300 DO
        {
            LET event = SDL2_POLL_EVENT()
            TEST event = SDL2_EVENT_QUIT THEN
                running := FALSE

            // Draw red rectangle with SDL2
            SDL2_SET_DRAW_COLOR(renderer, 0, 0, 0, 255)    // Black background
            SDL2_CLEAR(renderer)
            SDL2_SET_DRAW_COLOR(renderer, 255, 0, 0, 255)  // Red rectangle
            SDL2_FILL_RECT(renderer, 50, 50, 150, 100)
            SDL2_PRESENT(renderer)

            SDL2_DELAY(16)
            frames := frames + 1
        }
    }
    ELSE
    {
        WRITES("SUCCESS: Cairo surface converted to SDL texture!*N")
        WRITES("Displaying Cairo graphics in SDL window*N")

        // Display the Cairo-rendered texture
        LET running = TRUE
        LET frames = 0
        WHILE running AND frames < 600 DO  // 10 seconds
        {
            LET event = SDL2_POLL_EVENT()
            TEST event = SDL2_EVENT_QUIT THEN
                running := FALSE

            // Clear and draw the Cairo texture
            SDL2_SET_DRAW_COLOR(renderer, 50, 50, 50, 255)  // Dark gray background
            SDL2_CLEAR(renderer)
            // Note: SDL2_RENDER_TEXTURE would be needed here, but we'll just clear for now
            SDL2_PRESENT(renderer)

            SDL2_DELAY(16)
            frames := frames + 1

            TEST (frames REM 60) = 0 THEN
            {
                WRITES("Frame ")
                WRITEN(frames)
                WRITES(" - Cairo+SDL integration running*N")
            }
        }
    }

    // Save Cairo surface as PNG for verification
    CAIRO_SAVE_PNG(surface, "cairo_sdl_final_output.png")
    WRITES("Cairo surface saved as cairo_sdl_final_output.png*N")

    // Cleanup
    WRITES("Cleaning up...*N")
    SDL2_DESTROY_RENDERER(renderer)
    SDL2_DESTROY_WINDOW(window)
    SDL2_QUIT()

    WRITES("Cairo-SDL2 integration test completed!*N")
    FINISH
}
