// Debug test for Cairo SAMM heap allocation
// This test focuses on minimal surface creation to debug heap tracing

LET START() BE
{
    LET surface = 0

    WRITEF("=== CAIRO SAMM DEBUG TEST ===*N")
    WRITEF("Testing minimal Cairo surface creation with heap tracing*N*N")

    // Check Cairo availability
    LET cairo_available = CAIRO_IS_AVAILABLE()
    IF cairo_available = 0 THEN
    {
        WRITEF("ERROR: Cairo not available*N")
        FINISH
    }
    WRITEF("✓ Cairo is available*N")

    // Test 1: Create a single surface
    WRITEF("*NCreating surface (width=100, height=100)...*N")
    surface := CAIRO_CREATE_SURFACE(100, 100)

    IF surface = 0 THEN
    {
        WRITEF("ERROR: Failed to create surface*N")
        FINISH
    }

    WRITEF("✓ Surface created with handle: %N*N", surface)

    // Test 2: Perform minimal operation (clear)
    WRITEF("Clearing surface with white...*N")
    CAIRO_CLEAR(surface, #xFFFFFFFF)
    WRITEF("✓ Surface cleared*N")

    // Test 3: Save to verify it works
    WRITEF("*NSaving as debug_samm.png...*N")
    CAIRO_SAVE_PNG(surface, "debug_samm.png")
    WRITEF("✓ Image saved*N")

    WRITEF("*N=== CAIRO SAMM DEBUG TEST COMPLETE ===*N")
    WRITEF("Check the trace output above for OBJECT_HEAP_ALLOC calls*N")

    FINISH
}
