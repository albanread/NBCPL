LET fibonacci(n) = VALOF
$(
    TIMER_START("fibonacci")

    LET result = ?
    IF n <= 1 THEN
        result := n
    ELSE
    $(
        TIMER_START("fibonacci_recursive")
        result := fibonacci(n-1) + fibonacci(n-2)
        TIMER_END("fibonacci_recursive")
    $)

    TIMER_END("fibonacci")
    RESULTIS result
$)

LET sorting_test() BE
$(
    TIMER_START("sorting_test")

    // Create a simple array and do bubble sort
    LET arr = GETVEC(10)

    TIMER_START("array_init")
    FOR i = 0 TO 9 DO
        arr!i := RAND(100)
    TIMER_END("array_init")

    TIMER_START("bubble_sort")
    FOR i = 0 TO 8 DO
    $(
        FOR j = 0 TO 8-i DO
        $(
            IF arr!j > arr!(j+1) THEN
            $(
                LET temp = arr!j
                arr!j := arr!(j+1)
                arr!(j+1) := temp
            $)
        $)
    $)
    TIMER_END("bubble_sort")

    FREEVEC(arr)
    TIMER_END("sorting_test")
$)

LET loop_performance_test() BE
$(
    TIMER_START("loop_performance")

    FOR iteration = 1 TO 5 DO
    $(
        TIMER_START("loop_iteration")

        // Do some computation
        LET sum = 0
        FOR i = 1 TO 10000 DO
            sum := sum + i * i

        TIMER_END("loop_iteration")
    $)

    TIMER_END("loop_performance")
$)

LET START() BE
$(
    WRITEF("=== Comprehensive Timing System Test ==*N*N")

    TIMER_START("main_program")

    // Test 1: Simple function timing
    WRITEF("1. Testing simple function timing...*N")
    TIMER_START("simple_math")
    LET result = 0
    FOR i = 1 TO 50000 DO
        result := result + i
    TIMER_END("simple_math")

    // Test 2: Recursive function with nested timers
    WRITEF("2. Testing recursive function (fibonacci)...*N")
    LET fib_result = fibonacci(10)
    WRITEF("   Fibonacci(10) = %N*N", fib_result)

    // Test 3: Multiple iterations of the same timer
    WRITEF("3. Testing loop performance (5 iterations)...*N")
    loop_performance_test()

    // Test 4: Complex nested operations
    WRITEF("4. Testing sorting algorithm...*N")
    sorting_test()

    // Test 5: Query specific metrics
    WRITEF("*N5. Querying specific timer metrics:*N")
    LET main_ns = TIMER_GET_TOTAL_NS("main_program")
    LET main_calls = TIMER_GET_CALL_COUNT("main_program")
    LET loop_calls = TIMER_GET_CALL_COUNT("loop_iteration")

    WRITEF("   main_program total time: %N nanoseconds*N", main_ns)
    WRITEF("   main_program call count: %N*N", main_calls)
    WRITEF("   loop_iteration call count: %N*N", loop_calls)

    TIMER_END("main_program")

    // Display comprehensive metrics
    WRITEF("*N=== FINAL PERFORMANCE REPORT ===*N")
    TIMER_DISPLAY()

    WRITEF("*NTest completed successfully!*N")
$)
