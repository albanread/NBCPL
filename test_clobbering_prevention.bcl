// Test to verify that argument clobbering has been prevented
// This test uses complex expressions that would definitely cause clobbering
// with the old left-to-right evaluation approach

LET START() BE {
    WRITEF("Testing argument clobbering prevention*N")

    // Test 1: Simple clobbering scenario
    // In the old implementation: evaluating complex_b() would clobber simple_a()'s result
    WRITEF("Test 1: Simple clobbering scenario*N")
    LET result1 = clobbering_test(simple_a(), complex_b())
    WRITEF("Expected: 142, Actual: %d*N", result1)

    // Test 2: Multiple complex expressions
    // Each function call uses scratch registers internally
    WRITEF("Test 2: Multiple complex expressions*N")
    LET result2 = multi_clobber_test(
        func_uses_scratch_1(),
        func_uses_scratch_2(),
        func_uses_scratch_3(),
        func_uses_scratch_4()
    )
    WRITEF("Expected: 1000, Actual: %d*N", result2)

    // Test 3: Maximum stress - 7 complex arguments
    WRITEF("Test 3: Maximum stress with 7 arguments*N")
    LET result3 = max_stress_test(
        expensive_operation(1),
        expensive_operation(2),
        expensive_operation(3),
        expensive_operation(4),
        expensive_operation(5),
        expensive_operation(6),
        expensive_operation(7)
    )
    WRITEF("Expected: 280, Actual: %d*N", result3)

    // Test 4: Mixed variables and complex expressions
    LET var1 = 50
    LET var2 = 60
    WRITEF("Test 4: Mixed variables and expressions*N")
    LET result4 = mixed_test(
        var1,                           // Simple variable
        expensive_operation(8),         // Complex expression
        var2,                           // Simple variable
        nested_function_call(9, 10),    // Nested call
        var1 + var2,                    // Simple expression
        deep_calculation(11)            // Deep calculation
    )
    WRITEF("Expected: 430, Actual: %d*N", result4)

    WRITEF("All clobbering prevention tests completed*N")
}

// Test function that should return sum of its arguments
LET clobbering_test(a, b) BE {
    RESULTIS a + b
}

LET multi_clobber_test(a, b, c, d) BE {
    RESULTIS a + b + c + d
}

LET max_stress_test(a, b, c, d, e, f, g) BE {
    RESULTIS a + b + c + d + e + f + g
}

LET mixed_test(a, b, c, d, e, f) BE {
    RESULTIS a + b + c + d + e + f
}

// Functions that return predictable values but use scratch registers internally
LET simple_a() BE RESULTIS 42

LET complex_b() BE {
    // This function uses multiple scratch registers
    LET temp1 = 25 * 4
    LET temp2 = temp1 + 10
    LET temp3 = temp2 - 10
    RESULTIS temp3  // Should return 100
}

LET func_uses_scratch_1() BE {
    LET x = 10 * 10
    LET y = x + 50
    RESULTIS y  // Returns 150
}

LET func_uses_scratch_2() BE {
    LET a = 75 + 75
    LET b = a + 100
    RESULTIS b  // Returns 250
}

LET func_uses_scratch_3() BE {
    LET p = 200
    LET q = p + 100
    RESULTIS q  // Returns 300
}

LET func_uses_scratch_4() BE {
    LET m = 150 + 150
    RESULTIS m  // Returns 300
}

LET expensive_operation(n) BE {
    // Each call should return n * 40
    LET step1 = n * 10
    LET step2 = step1 * 2
    LET step3 = step2 * 2
    RESULTIS step3
}

LET nested_function_call(x, y) BE {
    // Should return (x + y) * 10 = 190
    LET sum = x + y
    LET temp1 = sum * 5
    LET temp2 = temp1 * 2
    RESULTIS temp2
}

LET deep_calculation(n) BE {
    // Should return n * 10 = 110
    LET a = n + n
    LET b = a + a
    LET c = b + a
    LET d = c - a
    RESULTIS d
}
