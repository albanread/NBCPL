// Test file to verify "Analyze As You Create" approach with actual vector lowering
// This should trigger the VectorPairwiseLowerer and test the integration

LET START() BE {
    WRITEF("=== Testing Analyze As You Create Approach ===*N")

    // Create two PAIRS vectors for vector operation
    LET vec1 = PAIRS 3
    LET vec2 = PAIRS 3

    // Initialize vectors with test data
    vec1!0 := PAIR(1, 2)
    vec1!1 := PAIR(3, 4)
    vec1!2 := PAIR(5, 6)

    vec2!0 := PAIR(10, 20)
    vec2!1 := PAIR(30, 40)
    vec2!2 := PAIR(50, 60)

    WRITEF("Vector 1: [(1,2), (3,4), (5,6)]*N")
    WRITEF("Vector 2: [(10,20), (30,40), (50,60)]*N")

    // This should trigger vector lowering: PAIRS + PAIRS -> explicit loop
    LET result = vec1 + vec2

    WRITEF("Result vector created successfully*N")
    WRITEF("Expected: [(11,22), (33,44), (55,66)]*N")

    WRITEF("=== Test completed successfully ===*N")
}
