// Test file to demonstrate scratch register exhaustion problem
// This should crash the compiler when it tries to evaluate 8+ arguments

LET START() BE {
    WRITEF("Testing scratch register exhaustion problem*N")

    // This function call has 9 arguments - should crash the compiler
    // due to scratch register exhaustion in the current implementation
    LET result = test_many_args(
        1,                    // arg 1 - uses scratch reg
        2 + 3,               // arg 2 - complex expr, uses more scratch regs
        4 * 5,               // arg 3 - another complex expr
        6 - 7,               // arg 4 - more complexity
        8 / 2,               // arg 5 - division
        10 + 20,             // arg 6 - addition
        30 * 40,             // arg 7 - multiplication
        50 - 60,             // arg 8 - THIS SHOULD CAUSE CRASH
        70 + 80              // arg 9 - if we get here, it's a miracle
    )

    WRITEF("If you see this message, the compiler didn't crash*N")
    WRITEF("Result: %d*N", result)
}

// Test function that takes 9 arguments
LET test_many_args(a, b, c, d, e, f, g, h, i) BE {
    WRITEF("Called with 9 arguments: %d %d %d %d %d %d %d %d %d*N",
           a, b, c, d, e, f, g, h, i)
    RESULTIS a + b + c + d + e + f + g + h + i
}

// Alternative test with even more complex expressions
LET test_complex_clobbering() BE {
    WRITEF("Testing argument clobbering with complex expressions*N")

    // This should demonstrate clobbering issues
    // The evaluation of later arguments may clobber earlier ones
    LET result = test_clobbering(
        simple_value(),           // Simple - goes to scratch reg X9
        complex_calculation(),    // Complex - may acquire X9, clobbering arg 1!
        another_function(),       // Another function call - more clobbering risk
        nested_expression()       // Even more complex
    )

    WRITEF("Clobbering test result: %d*N", result)
}

LET simple_value() BE RESULTIS 42

LET complex_calculation() BE {
    LET temp1 = 10 * 20
    LET temp2 = temp1 + 30
    LET temp3 = temp2 / 5
    RESULTIS temp3
}

LET another_function() BE {
    LET x = 100
    LET y = 200
    RESULTIS x + y
}

LET nested_expression() BE {
    RESULTIS simple_value() + complex_calculation()
}

LET test_clobbering(a, b, c, d) BE {
    WRITEF("Clobbering test args: %d %d %d %d*N", a, b, c, d)
    // If clobbering occurred, these values will be wrong
    RESULTIS a + b + c + d
}
