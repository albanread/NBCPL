
LET FACT(N) = VALOF
$(
  LET R = 1
  FOR I = 1 TO N DO
  $(
    R := R * I
    WRITES(" R = ") WRITEN(R) WRITES("*N")
  $)
  RESULTIS R
$)

LET START() = VALOF
$(
	WRITES("BEGIN*N")

	LET X= 12

	FOR i=1 TO 10000 DO $(
	TIMER_START("Fact")
  	LET U=FACT(X)
	TIMER_END("Fact")
	$)
	WRITES("END*N")

	TIMER_DISPLAY()
$)
