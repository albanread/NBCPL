LET START() BE {
    WRITEF("Testing simple OCTS vector addition\n")

    // Create two small OCTS vectors
    LET vec1 = OCTS(2)
    LET vec2 = OCTS(2)

    WRITEF("Created OCTS vectors\n")

    // Initialize with simple values
    vec1!0 := OCT(1, 2, 3, 4, 5, 6, 7, 8)
    vec1!1 := OCT(10, 11, 12, 13, 14, 15, 16, 17)

    vec2!0 := OCT(1, 1, 1, 1, 1, 1, 1, 1)
    vec2!1 := OCT(2, 2, 2, 2, 2, 2, 2, 2)

    WRITEF("Initialized vectors\n")

    // Perform vector addition - should trigger NEON lowering
    LET result = OCTS(2)
    result := vec1 + vec2

    WRITEF("Vector addition completed\n")
    WRITEF("Result length: %d\n", LEN(result))

    WRITEF("✅ OCTS simple addition test completed\n")
}
