// Very basic test with no vector operations to verify the compiler works
// This test only uses basic language features

LET start() BE {
    WRITEF("Testing basic compiler functionality...*N");

    // Test 1: Basic variable assignment
    LET x = 10;
    LET y = 20;
    WRITEF("x = %N, y = %N*N", x, y);

    // Test 2: Basic arithmetic
    LET sum = x + y;
    LET diff = y - x;
    WRITEF("sum = %N, diff = %N*N", sum, diff);

    // Test 3: Basic conditional
    TEST x < y THEN {
        WRITEF("x is less than y*N");
    } ELSE {
        WRITEF("x is not less than y*N");
    }

    WRITEF("Basic test completed successfully.*N");
}
