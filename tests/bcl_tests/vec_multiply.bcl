LET START() BE $(

	LET V1 = PAIRS(10)
	LET V2 = PAIRS(10)

	FOR I=0 TO 9 DO $(
  	 V1!I := PAIR(6,8)
         V2!I := PAIR(3,2)
	$)

	LET V3 = V1*V2

	WRITEF("*NVector multiplication completed!*N")
	WRITEF("Length of V3: %N*N", LEN(V3))

	WRITEF("*NVerifying results:*N")
	WRITEF("Expected: Each V3[i] = V1[i] * V2[i] = (6,8) * (3,2) = (18,16)*N")

	FOR I=0 TO 9 DO $(
		LET result_pair = V3!I
		WRITEF("V3[%N] = %P*N", I, result_pair)
	$)

$)
