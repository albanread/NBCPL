LET fibonacci(n) = VALOF
$(
    TIMER_START("fibonacci")

    LET result = ?
    IF n <= 1 THEN
        result := n
    ELSE
        result := fibonacci(n-1) + fibonacci(n-2)

    TIMER_END("fibonacci")
    RESULTIS result
$)

LET do_math_work() BE
$(
    TIMER_START("math_work")

    LET sum = 0
    FOR i = 1 TO 50000 DO
        sum := sum + i * i

    TIMER_END("math_work")
$)

LET START() BE
$(
    WRITEF("=== Timer Call Counting Test ==*N*N")

    // Test 1: Multiple separate calls to the same timer
    WRITEF("1. Testing multiple separate timer calls...*N")
    FOR iteration = 1 TO 5 DO
    $(
        WRITEF("   Iteration %N*N", iteration)
        do_math_work()  // Each call should increment the counter
    $)

    // Test 2: Recursive function calls (fibonacci)
    WRITEF("*N2. Testing recursive timer calls...*N")
    LET fib_result = fibonacci(8)
    WRITEF("   Fibonacci(8) = %N*N", fib_result)

    // Test 3: Mixed timer calls
    WRITEF("*N3. Testing mixed timer usage...*N")
    FOR i = 1 TO 3 DO
    $(
        TIMER_START("mixed_timer")
        LET temp = fibonacci(5)
        TIMER_END("mixed_timer")
    $)

    // Display results
    WRITEF("*N=== CALL COUNT VERIFICATION ===*N")
    LET math_calls = TIMER_GET_CALL_COUNT("math_work")
    LET fib_calls = TIMER_GET_CALL_COUNT("fibonacci")
    LET mixed_calls = TIMER_GET_CALL_COUNT("mixed_timer")

    WRITEF("Expected: math_work=5, fibonacci=25, mixed_timer=3*N")
    WRITEF("Actual:   math_work=%N, fibonacci=%N, mixed_timer=%N*N",
           math_calls, fib_calls, mixed_calls)

    WRITEF("*N=== PERFORMANCE METRICS ===*N")
    TIMER_DISPLAY()

    WRITEF("*NTest completed!*N")
$)
