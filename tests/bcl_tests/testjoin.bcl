LET START() BE
$(
    WRITEF("Testing JOIN function with proper syntax...*N")

    // Create a list with the strings we want to join
    LET word_list = LIST("this", "is", "the", "age", "of")

    // Join the list with underscore delimiter
    LET S = JOIN(word_list, "_")

    WRITEF("Type of S = %s*N", TYPE(S))
    WRITEF("Result: %s*N", S)
$)
