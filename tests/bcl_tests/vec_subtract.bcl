LET START() BE $(

	LET V1 = PAIRS(10)
	LET V2 = PAIRS(10)

	FOR I=0 TO 9 DO $(
  	 V1!I := PAIR(20,30)
         V2!I := PAIR(5,8)
	$)

	LET V3 = V1-V2

	WRITEF("*NVector subtraction completed!*N")
	WRITEF("Length of V3: %N*N", LEN(V3))

	WRITEF("*NVerifying results:*N")
	WRITEF("Expected: Each V3[i] = V1[i] - V2[i] = (20,30) - (5,8) = (15,22)*N")

	FOR I=0 TO 9 DO $(
		LET result_pair = V3!I
		WRITEF("V3[%N] = %P*N", I, result_pair)
	$)

$)
