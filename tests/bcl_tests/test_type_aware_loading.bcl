LET start() BE {
    // Test type-aware loading compatibility layer
    // This test ensures float arguments are loaded into D registers
    // and integer arguments are loaded into X registers

    LET int_val = 42
    LET float_val = 3.14

    // Test function call with mixed argument types
    // The compatibility layer should:
    // - Load int_val from stack into X register
    // - Load float_val from stack into D register
    test_mixed_args(int_val, float_val, int_val + 10)

    // Test routine call with mixed argument types
    test_mixed_routine(float_val, int_val)

    WRITEF("Type-aware loading test completed*N")
}

LET test_mixed_args(int_arg, float_arg, another_int) BE {
    // This function receives:
    // int_arg (integer) -> should come from X register
    // float_arg (float) -> should come from D register
    // another_int (integer) -> should come from X register

    WRITEF("Received: int=%N, float=%F, int2=%N*N", int_arg, float_arg, another_int)
}

LET test_mixed_routine(f_arg, i_arg) BE {
    // This routine receives:
    // f_arg (float) -> should come from D register
    // i_arg (integer) -> should come from X register

    WRITEF("Routine received: float=%F, int=%N*N", f_arg, i_arg)
}
