LET START() BE $(
    WRITEF("Testing FPAIRS allocation and length*N")
    WRITEF("========================================*N")

    // Test 1: Small FPAIRS allocation
    WRITEF("Test 1: Creating FPAIRS(5)*N")
    LET fp_vec = FPAIRS(5)
    WRITEF("Expected length: 5*N")
    WRITEF("Actual length: %N*N", LEN(fp_vec))
    IF LEN(fp_vec) = 5 THEN $(
        WRITEF("✓ PASS: Length is correct*N")
    $) ELSE $(
        WRITEF("✗ FAIL: Length mismatch!*N")
    $)
    WRITEF("*N")

    // Test 2: Different size FPAIRS allocation
    WRITEF("Test 2: Creating FPAIRS(10)*N")
    LET fp_vec2 = FPAIRS(10)
    WRITEF("Expected length: 10*N")
    WRITEF("Actual length: %N*N", LEN(fp_vec2))
    IF LEN(fp_vec2) = 10 THEN $(
        WRITEF("✓ PASS: Length is correct*N")
    $) ELSE $(
        WRITEF("✗ FAIL: Length mismatch!*N")
    $)
    WRITEF("*N")

    // Test 3: Compare with PAIRS allocation for reference
    WRITEF("Test 3: Reference PAIRS allocation*N")
    LET p_vec = PAIRS(7)
    WRITEF("PAIRS(7) length: %N*N", LEN(p_vec))
    IF LEN(p_vec) = 7 THEN $(
        WRITEF("✓ PAIRS reference works correctly*N")
    $) ELSE $(
        WRITEF("✗ PAIRS reference broken too!*N")
    $)
    WRITEF("*N")

    // Test 4: Edge cases
    WRITEF("Test 4: Edge case FPAIRS(1)*N")
    LET fp_single = FPAIRS(1)
    WRITEF("FPAIRS(1) length: %N*N", LEN(fp_single))
    IF LEN(fp_single) = 1 THEN $(
        WRITEF("✓ PASS: Single element works*N")
    $) ELSE $(
        WRITEF("✗ FAIL: Single element broken*N")
    $)

    WRITEF("*N")
    WRITEF("Length testing completed*N")
$)
