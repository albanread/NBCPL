LET START() BE {

    WRITEF("Testing Stage 2: Vector Operation Detection*N")

    // Create two PAIRS vectors for testing
    LET vec1 = PAIRS 2
    LET vec2 = PAIRS 2

    // Initialize the vectors
    vec1!0 := PAIR(1, 2)
    vec1!1 := PAIR(3, 4)

    vec2!0 := PAIR(5, 6)
    vec2!1 := PAIR(7, 8)

    WRITEF("vec1: PAIR(1,2), PAIR(3,4)*N")
    WRITEF("vec2: PAIR(5,6), PAIR(7,8)*N")

    // Test vector addition - this should be detected by Stage 2
    WRITEF("*NTesting vector addition: vec1 + vec2*N")
    LET result_add = vec1 + vec2

    // Test vector subtraction
    WRITEF("Testing vector subtraction: vec1 - vec2*N")
    LET result_sub = vec1 - vec2

    // Test vector multiplication
    WRITEF("Testing vector multiplication: vec1 * vec2*N")
    LET result_mul = vec1 * vec2

    // If we get here without compilation errors, Stage 2 type detection is working
    WRITEF("*NSUCCESS: All vector operations detected and typed correctly!*N")
    WRITEF("Stage 2 test complete.*N")
}
