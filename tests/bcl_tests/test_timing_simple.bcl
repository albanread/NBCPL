LET START() BE
$(
    WRITEF("=== Simple Timing Test ==*N")

    FOR k = 1 TO 10 DO $(
    	TIMER_START("test_function")
   	 WRITEF("Doing some work...*N")
   	 FOR i = 1 TO 100000 DO
        	LET x = i * i
    	
    	  TIMER_END("test_function")
	$)

    TIMER_DISPLAY()
    WRITEF("Test complete - metrics displayed above*N")
$)
