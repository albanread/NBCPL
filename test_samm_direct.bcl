// Direct SAMM functionality test without relying on debug output
// This test verifies that SAMM is actually working by testing allocation tracking

LET START() BE
{
    LET surface1 = 0
    LET surface2 = 0
    LET surface3 = 0

    WRITEF("=== DIRECT SAMM FUNCTIONALITY TEST ===*N")
    WRITEF("This test verifies SAMM is working without debug output*N*N")

    // Check Cairo availability
    LET cairo_available = CAIRO_IS_AVAILABLE()
    IF cairo_available = 0 THEN
    {
        WRITEF("ERROR: Cairo not available*N")
        FINISH
    }
    WRITEF("Cairo is available*N")

    // Test 1: Check initial surface count
    LET initial_count = CAIRO_SURFACE_COUNT()
    WRITEF("Initial surface count: %N*N", initial_count)

    // Test 2: Create multiple surfaces and verify count increases
    WRITEF("Creating 3 surfaces...*N")

    surface1 := CAIRO_CREATE_SURFACE(100, 100)
    IF surface1 = 0 THEN
    {
        WRITEF("ERROR: Failed to create surface1*N")
        FINISH
    }

    surface2 := CAIRO_CREATE_SURFACE(200, 200)
    IF surface2 = 0 THEN
    {
        WRITEF("ERROR: Failed to create surface2*N")
        FINISH
    }

    surface3 := CAIRO_CREATE_SURFACE(300, 300)
    IF surface3 = 0 THEN
    {
        WRITEF("ERROR: Failed to create surface3*N")
        FINISH
    }

    // Test 3: Verify surface count increased
    LET after_creation_count = CAIRO_SURFACE_COUNT()
    WRITEF("Surface count after creation: %N*N", after_creation_count)

    LET expected_count = initial_count + 3
    IF after_creation_count = expected_count THEN
    {
        WRITEF("Surface tracking working correctly*N")
    }
    ELSE
    {
        WRITEF("Surface tracking issue: expected %N, got %N*N", expected_count, after_creation_count)
    }

    // Test 4: Use the surfaces to verify they work
    WRITEF("*NTesting surface operations...*N")
    CAIRO_CLEAR(surface1, #xFF0000FF)  // Red
    CAIRO_CLEAR(surface2, #x00FF00FF)  // Green
    CAIRO_CLEAR(surface3, #x0000FFFF)  // Blue
    WRITEF("All surfaces cleared with different colors*N")

    // Test 5: Draw something on each surface
    CAIRO_SET_COLOR(surface1, #x000000FF)
    CAIRO_FILL_CIRCLE(surface1, 50, 50, 20)

    CAIRO_SET_COLOR(surface2, #x000000FF)
    CAIRO_FILL_RECT(surface2, 50, 50, 100, 100)

    CAIRO_SET_COLOR(surface3, #x000000FF)
    CAIRO_DRAW_LINE(surface3, 0, 0, 300, 300)

    WRITEF("Drew shapes on all surfaces*N")

    // Test 6: Save surfaces to verify they contain correct data
    CAIRO_SAVE_PNG(surface1, "samm_test_surface1.png")
    CAIRO_SAVE_PNG(surface2, "samm_test_surface2.png")
    CAIRO_SAVE_PNG(surface3, "samm_test_surface3.png")
    WRITEF("All surfaces saved as PNG files*N")

    // Test 7: Manually release one surface and check count
    WRITEF("*NManually releasing surface2...*N")
    CAIRO_RELEASE_SURFACE(surface2)

    LET after_release_count = CAIRO_SURFACE_COUNT()
    WRITEF("Surface count after manual release: %N*N", after_release_count)

    LET expected_after_release = expected_count - 1
    IF after_release_count = expected_after_release THEN
    {
        WRITEF("Manual surface release working correctly*N")
    }
    ELSE
    {
        WRITEF("Manual release issue: expected %N, got %N*N", expected_after_release, after_release_count)
    }

    // Test 8: Final verification
    WRITEF("*NFinal surface count: %N*N", CAIRO_SURFACE_COUNT())
    WRITEF("Remaining surfaces should be cleaned up by SAMM on program exit*N")

    WRITEF("*N=== DIRECT SAMM FUNCTIONALITY TEST COMPLETE ===*N")
    WRITEF("Test passed - SAMM surface tracking is functional*N")
    WRITEF("*NNote: Watch for SAMM cleanup messages when program exits*N")

    FINISH
}
