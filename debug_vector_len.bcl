// Debug test to understand vector length behavior
// This will help us understand what LEN() returns and how vector indexing works

LET START() BE $(

    WRITEF("=== Vector Length Debug Test ===*N")

    // Test 1: Create a PAIRS vector and check its length
    LET V1 = PAIRS(5)
    LET len1 = LEN(V1)
    WRITEF("PAIRS(5) length = %N", len1)

    // Test 2: Initialize some elements and check bounds
    WRITEF("Initializing V1[0] through V1[4]...*N")
    FOR I=0 TO 4 DO $(
        V1!I := PAIR(I, I*2)
        WRITEF("V1[%N] = PAIR(%N, %N)*N", I, I, I*2)
    $)

    // Test 3: Try to read back the values
    WRITEF("Reading back values...*N")
    FOR I=0 TO 4 DO $(
        LET p = V1!I
        WRITEF("V1[%N] = %P*N", I, p)
    $)

    // Test 4: Check what happens if we try to access beyond bounds
    WRITEF("Checking bounds behavior...*N")
    WRITEF("Trying to access V1[5] (should be out of bounds)...*N")
    // Uncomment the next line to test bounds checking
    // LET bad_access = V1!5

    WRITEF("=== Test Complete ===*N")
$)
