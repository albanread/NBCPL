LET START() BE $(

	LET V1 = PAIRS(3)

	FOR I=0 TO 2 DO $(
  	 V1!I := PAIR(10,20)
	$)

	WRITEF("*NPAIRS allocation completed!*N")
	WRITEF("Length of V1: %N*N", LEN(V1))

	WRITEF("*NVerifying results:*N")
	FOR I=0 TO 2 DO $(
		LET result_pair = V1!I
		WRITEF("V1[%N] = (%N,%N)*N", I, result_pair.FIRST, result_pair.SECOND)
	$)

	FREEVEC(V1)
	WRITEF("PAIRS test completed successfully!*N")
$)
